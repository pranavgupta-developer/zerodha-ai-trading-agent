# .env.example — copy to .env and fill in your values before starting the server.
# cp .env.example .env

# ─── Zerodha / Kite Connect (REQUIRED) ─────────────────────────────────────────
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
# NOTE: Do NOT store KITE_REQUEST_TOKEN here.
# It is a one-time OAuth token generated during login and set at runtime.

# ─── Google Gemini AI (required for AI agent decision-making) ──────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Trading Mode (CRITICAL — read this before changing) ──────────────────────
# DRY_RUN : No real orders. Safe for development, backtesting, and CI.
# LIVE    : Real orders execute against your funded Zerodha account.
TRADING_MODE=DRY_RUN

# AUTONOMOUS_EXECUTION controls whether the AI agent fires orders without
# requiring a human confirmation click on the dashboard.
# ⚠️  Set to False during initial testing to approve every trade manually.
AUTONOMOUS_EXECUTION=False

# ─── Watchlist ─────────────────────────────────────────────────────────────────
# Comma-separated symbols in NSE format (with .NS suffix)
TRADING_SYMBOLS=RELIANCE.NS,TCS.NS,INFY.NS,HDFCBANK.NS,ICICIBANK.NS

# ─── Database ──────────────────────────────────────────────────────────────────
# Default: SQLite (development only — concurrent writes will cause lock errors).
# For production, use PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/trading_agent
DATABASE_URL=sqlite:///./trading_agent.db
